{
  "manifest_version": 3,
  "name": "Affilyatics",
  "version": "5.0.0",
  "description": "Your Amazon Associates earnings in one click: all stores and countries, live up to today, with alerts. Free, with a Pro plan.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://affilyatics.com/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "identity"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://affiliate-program.amazon.com/*",
    "https://associates.amazon.ca/*",
    "https://identitytoolkit.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Affilyatics",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
