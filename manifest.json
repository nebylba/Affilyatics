{
  "manifest_version": 3,
  "name": "Affilyatics",
  "version": "5.1.3",
  "description": "Your Amazon Associates earnings in one click: all stores and countries, live up to today, with alerts. Free, with a Pro plan.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://affilyatics.com/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "identity",
    "gcm"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://affiliate-program.amazon.com/*",
    "https://affiliate-program.amazon.co.uk/*",
    "https://partnernet.amazon.de/*",
    "https://partenaires.amazon.fr/*",
    "https://affiliate.amazon.co.jp/*",
    "https://associates.amazon.ca/*",
    "https://programma-affiliazione.amazon.it/*",
    "https://afiliados.amazon.es/*",
    "https://affiliate-program.amazon.in/*",
    "https://associados.amazon.com.br/*",
    "https://afiliados.amazon.com.mx/*",
    "https://affiliate-program.amazon.com.au/*",
    "https://affiliate-program.amazon.ae/*",
    "https://affiliate-program.amazon.sg/*",
    "https://partnernet.amazon.nl/*",
    "https://affiliate-program.amazon.sa/*",
    "https://affiliate-program.amazon.se/*",
    "https://affiliate-program.amazon.pl/*",
    "https://affiliate-program.amazon.com.be/*",
    "https://affiliate-program.amazon.ie/*",
    "https://gelirortakligi.amazon.com.tr/*",
    "https://affiliate-program.amazon.eg/*",
    "https://identitytoolkit.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Affilyatics",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "key": ""
}
